# ====================================================================
# PROJECT CONFIGURATION - Copy this to .env and update with your values
# ====================================================================

# BACKEND API URL
# Update with your local IP address
BACKEND_URL=http://YOUR_IP:8000

# MONGODB CONNECTION
MONGODB_URL=your-mongodb-connection-string
MONGODB_DB_NAME=mona360

# API CONFIGURATION
API_BASE_URL=http://YOUR_IP:8000/api/v1
API_TIMEOUT=30000
DEBUG_API_LOGS=true

# AUTHENTICATION
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
ALGORITHM=HS256
REFRESH_TOKEN_EXPIRY=7d
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# FILE UPLOAD
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_FORMATS=pdf,doc,docx,txt

# FEATURES
ENABLE_BIOMETRIC_AUTH=true
ENABLE_PUSH_NOTIFICATIONS=true

# PROJECT METADATA
PROJECT_NAME=MONA 360
VERSION=1.0.0
DESCRIPTION=Backend for Sikkim Tourism mobile app

# CORS
ALLOWED_ORIGINS=["*"]

# GEMINI API
GEMINI_API_KEY=your-gemini-api-key

# CDN CONFIGURATION
CDN_URL=https://models.shrishesha.space/api/media/upload
CDN_MODEL_URL=https://models.shrishesha.space/api/models/upload
CDN_API_KEY=promatrs@25
LOCAL_IP=YOUR_IP

# ====================================================================
# SETUP INSTRUCTIONS
# ====================================================================
# 1. Copy this file: cp .env.example .env
# 2. Find your IP: ifconfig | grep "inet " | grep -v 127.0.0.1
# 3. Update BACKEND_URL, API_BASE_URL, and LOCAL_IP with your IP
# 4. Add your MongoDB connection string
# 5. Start backend: cd be && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000
# 6. Start mobile app: cd mobile_app && npx expo start -c
# ====================================================================
