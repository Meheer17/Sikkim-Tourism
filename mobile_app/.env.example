# API Configuration
# For physical devices or when emulator doesn't work, 
# replace with your machine's local IP address
# Find it by running: ipconfig getifaddr en0 (Mac) or ipconfig (Windows)

# Example for physical device:
# API_BASE_URL=http://192.168.1.100:8000/api/v1

# Android Emulator (default)
# API_BASE_URL=http://10.0.2.2:8000/api/v1

# iOS Simulator (default)
# API_BASE_URL=http://localhost:8000/api/v1

# API_TIMEOUT=10000
# DEBUG_API_LOGS=true
